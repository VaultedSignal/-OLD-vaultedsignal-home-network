services:
  cleanuparr:
    image: ghcr.io/cleanuparr/cleanuparr:latest
    container_name: cleanuparr
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Amsterdam
      - PORT=5050 # Default is often 5050
    volumes:
      - /docker/cleanuparr/config:/config
    ports:
      - "5050:5050"
    restart: unless-stopped
